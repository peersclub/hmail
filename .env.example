# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Google OAuth client ID (Google Cloud Console → APIs & Services → Credentials).
# Leave empty to use the app in demo mode only.
GOOGLE_CLIENT_ID=

# AI brief via OpenRouter (optional — the app works fully without it;
# the daily brief falls back to the built-in rule engine).
OPENROUTER_API_KEY=
# Optional model override; any OpenRouter chat model slug works.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
